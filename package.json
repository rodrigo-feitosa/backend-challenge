{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "description": "Distributed wagering processor — Jungle Gaming technical challenge",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start:dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun test/load/run-load.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "migration:up": "bun run scripts/migrate.ts up",
    "migration:down": "bun run scripts/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1153.0",
    "@mikro-orm/core": "^6.6",
    "@mikro-orm/migrations": "^6.6",
    "@mikro-orm/postgresql": "^6.6",
    "@nestjs/common": "^12",
    "@nestjs/core": "^12",
    "@nestjs/platform-express": "^12",
    "@nestjs/terminus": "^12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0"
  }
}
