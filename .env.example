# --- HTTP ---
PORT=3000

# --- Logging ---
LOG_LEVEL=info

# --- PostgreSQL ---
DATABASE_URL=postgresql://app:app@localhost:5432/wagering

# --- AWS SQS (LocalStack local) ---
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_TRANSACTIONS_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_QUEUE_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_QUEUE_EVENTS_URL=http://localhost:4566/000000000000/wagering-events.fifo

# --- SQS consumer ---
VISIBILITY_TIMEOUT_S=90
DLQ_MAX_RECEIVES=3

# --- Outbox publisher ---
OUTBOX_MAX_ATTEMPTS=20

# --- Pending reference worker ---
PENDING_REF_MAX_ATTEMPTS=10
PENDING_REF_TTL_HOURS=24

# --- Workers (intervalo de polling, em ms) ---
OUTBOX_POLL_INTERVAL_MS=1000
PENDING_REF_POLL_INTERVAL_MS=5000

# --- Auth (Keycloak OIDC) ---
AUTH_ENABLED=true
AUTH_ISSUER_URL=http://localhost:8080/realms/jungle
AUTH_AUDIENCE=wagering-api
